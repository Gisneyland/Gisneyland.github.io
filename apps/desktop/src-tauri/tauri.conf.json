{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "風城部屋",
  "version": "1.0.0",
  "identifier": "io.github.gisneyland.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "風城部屋 GisneyLand",
        "url": "https://gisneyland.github.io/",
        "width": 1200,
        "height": 800
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "rpm"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
