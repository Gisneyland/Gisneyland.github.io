{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Jekyll: serve",
      "type": "shell",
      "command": "bundle exec jekyll serve --livereload --drafts --host 127.0.0.1",
      "isBackground": true,
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Server address",
          "endsPattern": "Server address"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "close": false
      }
    }
  ]
}
